# =====================
# RustyExpress Docker Deployment Configuration
# =====================
# Copy this file to .env and modify as needed

# Docker image registry mirror
# 国内用户如果无法连接 Docker Hub，可设置镜像加速器
# 填镜像地址前缀，例如 docker.m.daocloud.io/
# 留空则使用 Docker Hub 官方源
REGISTRY_MIRROR=

# =====================
# Server
# =====================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# =====================
# Database
# =====================
DATABASE_URL=postgres://rustyexpress:rustyexpress_secret@postgres:5432/rustyexpress
DB_MAX_CONNECTIONS=10

# =====================
# JWT
# =====================
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRATION_HOURS=168

# =====================
# Docker Compose 配置
# =====================
POSTGRES_USER=rustyexpress
POSTGRES_PASSWORD=rustyexpress_secret
POSTGRES_DB=rustyexpress
POSTGRES_PORT=5432
RUST_LOG=info
FRONTEND_PORT=80
