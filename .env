# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Database
DATABASE_URL=postgres://rustyexpress:rustyexpress_secret@postgres:5432/rustyexpress
DB_MAX_CONNECTIONS=10

# JWT
JWT_SECRET=rustyexpress_secret_key_change_in_production_2024
JWT_EXPIRATION_HOURS=168

# Docker Compose
POSTGRES_USER=rustyexpress
POSTGRES_PASSWORD=rustyexpress_secret
POSTGRES_DB=rustyexpress
POSTGRES_PORT=5432
RUST_LOG=info
FRONTEND_PORT=80
